job "tcg-medusa" {
  datacenters = ["dc1"]
  type        = "service"

  group "tcg-medusa" {
    network {
      port "redis" {
        to = 6379
      }
      port "backend" {
        to = 9000
      }
      port "storefront" {
        to = 8000
      }
    }

    task "backend" {
      driver = "docker"

      template {
        data = <<EOF
DATABASE_URL="{{ with nomadVar "tcg-store/medusa-database" }}{{ .database_url }}{{ end }}"
REDIS_URL="redis://{{ env "NOMAD_IP_redis" }}:{{ env "NOMAD_HOST_PORT_redis" }}"
JWT_SECRET="{{ with nomadVar "tcg-store/medusa-secrets" }}{{ .jwt_secret }}{{ end }}"
COOKIE_SECRET="{{ with nomadVar "tcg-store/medusa-secrets" }}{{ .cookie_secret }}{{ end }}"
EOF
        destination = "local/backend-secrets.env"
        env         = true
      }

      template {
        data = <<EOF
DOCKER_USERNAME="{{ with nomadVar "personifi/ghcr" }}{{ .username }}{{ end }}"
DOCKER_PASSWORD="{{ with nomadVar "personifi/ghcr" }}{{ .password }}{{ end }}"
EOF
        destination = "local/backend-docker-auth.env"
        env         = true
      }

      config {
        image = "BACKEND_IMAGE_PLACEHOLDER"
        ports = ["backend"]

        labels = {
          "traefik.enable" = "true"

          "traefik.http.routers.tcg-medusa-api.rule" = "Host(`api.staging.craigscards.co.uk`)"
          "traefik.http.routers.tcg-medusa-api.entrypoints" = "web"

          "traefik.http.routers.tcg-medusa-api-secure.rule" = "Host(`api.staging.craigscards.co.uk`)"
          "traefik.http.routers.tcg-medusa-api-secure.entrypoints" = "websecure"
          "traefik.http.routers.tcg-medusa-api-secure.tls" = "true"
          "traefik.http.routers.tcg-medusa-api-secure.tls.certresolver" = "letsencrypt"

          "traefik.http.services.tcg-medusa-api.loadbalancer.server.port" = "9000"
        }

        auth {
          username = "${DOCKER_USERNAME}"
          password = "${DOCKER_PASSWORD}"
        }
      }

      env {
        NODE_ENV = "production"
        PORT     = "9000"
        DEPLOY_VERSION = "DEPLOY_VERSION_PLACEHOLDER"
        CI = "true"
        PNPM_CONFIG_CONFIRM_MODULES_PURGE = "false"

        STORE_CORS = "https://staging.craigscards.co.uk"
        ADMIN_CORS = "https://api.staging.craigscards.co.uk"
        AUTH_CORS  = "https://api.staging.craigscards.co.uk,https://staging.craigscards.co.uk"
      }

      resources {
        cpu    = 500
        memory = 1536
      }
    }

    task "redis" {
      driver = "docker"

      config {
        image = "redis:7-alpine"
        ports = ["redis"]
        args  = ["redis-server", "--appendonly", "yes"]
        volumes = [
          "/opt/tcg-medusa/redis:/data"
        ]
      }

      resources {
        cpu    = 100
        memory = 128
      }
    }

    task "storefront" {
      driver = "docker"

      template {
        data = <<EOF
DOCKER_USERNAME="{{ with nomadVar "personifi/ghcr" }}{{ .username }}{{ end }}"
DOCKER_PASSWORD="{{ with nomadVar "personifi/ghcr" }}{{ .password }}{{ end }}"
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY="{{ with nomadVar "tcg-store/medusa-secrets" }}{{ .publishable_key }}{{ end }}"
NEXT_PUBLIC_STRIPE_KEY="{{ with nomadVar "tcg-store/medusa-secrets" }}{{ .stripe_publishable_key }}{{ end }}"
EOF
        destination = "local/storefront-secrets.env"
        env         = true
      }

      config {
        image = "STOREFRONT_IMAGE_PLACEHOLDER"
        ports = ["storefront"]

        labels = {
          "traefik.enable" = "true"

          "traefik.http.routers.tcg-medusa-storefront.rule" = "Host(`staging.craigscards.co.uk`)"
          "traefik.http.routers.tcg-medusa-storefront.entrypoints" = "web"

          "traefik.http.routers.tcg-medusa-storefront-secure.rule" = "Host(`staging.craigscards.co.uk`)"
          "traefik.http.routers.tcg-medusa-storefront-secure.entrypoints" = "websecure"
          "traefik.http.routers.tcg-medusa-storefront-secure.tls" = "true"
          "traefik.http.routers.tcg-medusa-storefront-secure.tls.certresolver" = "letsencrypt"

          "traefik.http.services.tcg-medusa-storefront.loadbalancer.server.port" = "8000"
        }

        auth {
          username = "${DOCKER_USERNAME}"
          password = "${DOCKER_PASSWORD}"
        }
      }

      env {
        NODE_ENV = "production"
        PORT     = "8000"
        DEPLOY_VERSION = "DEPLOY_VERSION_PLACEHOLDER"

        MEDUSA_BACKEND_URL             = "https://api.staging.craigscards.co.uk"
        NEXT_PUBLIC_MEDUSA_BACKEND_URL = "https://api.staging.craigscards.co.uk"
        NEXT_PUBLIC_DEFAULT_REGION     = "gb"
        NEXT_PUBLIC_BASE_URL           = "https://staging.craigscards.co.uk"
      }

      resources {
        cpu    = 500
        memory = 384
      }
    }
  }
}
