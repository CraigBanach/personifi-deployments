job "tcg-medusa-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER" {
  datacenters = ["dc1"]
  type        = "service"

  group "tcg-medusa" {
    network {
      port "redis" {
        to = 6379
      }
      port "backend" {
        to = 9000
      }
      port "storefront" {
        to = 8000
      }
    }

    task "backend" {
      driver = "docker"

      template {
        data = <<EOF
DATABASE_URL="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/database" }}{{ .database_url }}{{ end }}"
REDIS_URL="redis://{{ env "NOMAD_IP_redis" }}:{{ env "NOMAD_HOST_PORT_redis" }}"
JWT_SECRET="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ .jwt_secret }}{{ end }}"
COOKIE_SECRET="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ .cookie_secret }}{{ end }}"
STRIPE_API_KEY="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if .stripe_api_key }}{{ .stripe_api_key }}{{ end }}{{ end }}"
STRIPE_WEBHOOK_SECRET="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if .stripe_webhook_secret }}{{ .stripe_webhook_secret }}{{ end }}{{ end }}"
NEXT_PUBLIC_STRIPE_KEY="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if .stripe_publishable_key }}{{ .stripe_publishable_key }}{{ end }}{{ end }}"
TRANSACTIONAL_SMTP_HOST="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "transactional_smtp_host" }}{{ index . "transactional_smtp_host" }}{{ end }}{{ end }}"
TRANSACTIONAL_SMTP_PORT="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "transactional_smtp_port" }}{{ index . "transactional_smtp_port" }}{{ end }}{{ end }}"
TRANSACTIONAL_SMTP_SECURE="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "transactional_smtp_secure" }}{{ index . "transactional_smtp_secure" }}{{ end }}{{ end }}"
TRANSACTIONAL_SMTP_USER="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "transactional_smtp_user" }}{{ index . "transactional_smtp_user" }}{{ end }}{{ end }}"
TRANSACTIONAL_SMTP_PASSWORD="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "transactional_smtp_password" }}{{ index . "transactional_smtp_password" }}{{ end }}{{ end }}"
TRANSACTIONAL_FROM_EMAIL="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "transactional_from_email" }}{{ index . "transactional_from_email" }}{{ end }}{{ end }}"
EOF
        destination = "local/backend-secrets.env"
        env         = true
      }

      template {
        data = <<EOF
DOCKER_USERNAME="{{ with nomadVar "personifi/ghcr" }}{{ .username }}{{ end }}"
DOCKER_PASSWORD="{{ with nomadVar "personifi/ghcr" }}{{ .password }}{{ end }}"
EOF
        destination = "local/backend-docker-auth.env"
        env         = true
      }

      config {
        image = "BACKEND_IMAGE_PLACEHOLDER"
        ports = ["backend"]
        volumes = [
          "TCG_MEDUSA_STATE_PATH_PLACEHOLDER/static:/app/apps/backend/.medusa/server/static"
        ]

        labels = {
          "traefik.enable" = "true"

          "traefik.http.routers.tcg-medusa-api-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.rule" = "Host(`API_HOST_PLACEHOLDER`)"
          "traefik.http.routers.tcg-medusa-api-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.entrypoints" = "web"

          "traefik.http.routers.tcg-medusa-api-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.rule" = "Host(`API_HOST_PLACEHOLDER`)"
          "traefik.http.routers.tcg-medusa-api-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.entrypoints" = "websecure"
          "traefik.http.routers.tcg-medusa-api-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.tls" = "true"
          "traefik.http.routers.tcg-medusa-api-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.tls.certresolver" = "letsencrypt"

          "traefik.http.services.tcg-medusa-api-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.loadbalancer.server.port" = "9000"
        }

        auth {
          username = "${DOCKER_USERNAME}"
          password = "${DOCKER_PASSWORD}"
        }
      }

      env {
        NODE_ENV = "production"
        PORT     = "9000"
        DEPLOY_VERSION = "DEPLOY_VERSION_PLACEHOLDER"
        CI = "true"
        PNPM_CONFIG_CONFIRM_MODULES_PURGE = "false"

        DEPLOYMENT_ENV = "DEPLOYMENT_ENVIRONMENT_PLACEHOLDER"
        STORE_CORS = "https://STOREFRONT_HOST_PLACEHOLDER"
        ADMIN_CORS = "https://API_HOST_PLACEHOLDER"
        AUTH_CORS  = "https://API_HOST_PLACEHOLDER,https://STOREFRONT_HOST_PLACEHOLDER"
        MEDUSA_BACKEND_URL = "https://API_HOST_PLACEHOLDER"
      }

      resources {
        cpu    = 500
        memory = 1536
      }
    }

    task "redis" {
      driver = "docker"

      config {
        image = "redis:7-alpine"
        ports = ["redis"]
        args  = ["redis-server", "--appendonly", "yes"]
        volumes = [
          "TCG_MEDUSA_STATE_PATH_PLACEHOLDER/redis:/data"
        ]
      }

      resources {
        cpu    = 100
        memory = 128
      }
    }

    task "storefront" {
      driver = "docker"

      template {
        data = <<EOF
DOCKER_USERNAME="{{ with nomadVar "personifi/ghcr" }}{{ .username }}{{ end }}"
DOCKER_PASSWORD="{{ with nomadVar "personifi/ghcr" }}{{ .password }}{{ end }}"
MEDUSA_PUBLISHABLE_KEY="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ .publishable_key }}{{ end }}"
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ .publishable_key }}{{ end }}"
NEXT_PUBLIC_STRIPE_KEY="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ .stripe_publishable_key }}{{ end }}"
SMTP_HOST="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "contact_smtp_host" }}{{ index . "contact_smtp_host" }}{{ end }}{{ end }}"
SMTP_PORT="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "contact_smtp_port" }}{{ index . "contact_smtp_port" }}{{ end }}{{ end }}"
SMTP_SECURE="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "contact_smtp_secure" }}{{ index . "contact_smtp_secure" }}{{ end }}{{ end }}"
SMTP_USER="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "contact_smtp_user" }}{{ index . "contact_smtp_user" }}{{ end }}{{ end }}"
SMTP_PASSWORD="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "contact_smtp_password" }}{{ index . "contact_smtp_password" }}{{ end }}{{ end }}"
CONTACT_FROM_EMAIL="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "contact_from_email" }}{{ index . "contact_from_email" }}{{ end }}{{ end }}"
CONTACT_TO_EMAIL="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "contact_to_email" }}{{ index . "contact_to_email" }}{{ end }}{{ end }}"
EOF
        destination = "local/storefront-secrets.env"
        env         = true
      }

      config {
        image = "STOREFRONT_IMAGE_PLACEHOLDER"
        ports = ["storefront"]

        labels = {
          "traefik.enable" = "true"

          "traefik.http.routers.tcg-medusa-storefront-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.rule" = "Host(`STOREFRONT_HOST_PLACEHOLDER`)"
          "traefik.http.routers.tcg-medusa-storefront-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.entrypoints" = "web"

          "traefik.http.routers.tcg-medusa-storefront-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.rule" = "Host(`STOREFRONT_HOST_PLACEHOLDER`)"
          "traefik.http.routers.tcg-medusa-storefront-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.entrypoints" = "websecure"
          "traefik.http.routers.tcg-medusa-storefront-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.tls" = "true"
          "traefik.http.routers.tcg-medusa-storefront-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.tls.certresolver" = "letsencrypt"

          # PRODUCTION_REDIRECT_START
          "traefik.http.routers.tcg-medusa-storefront-www-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.rule" = "Host(`STOREFRONT_REDIRECT_HOST_PLACEHOLDER`)"
          "traefik.http.routers.tcg-medusa-storefront-www-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.entrypoints" = "web"
          "traefik.http.routers.tcg-medusa-storefront-www-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.middlewares" = "tcg-medusa-storefront-www-redirect-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER"

          "traefik.http.routers.tcg-medusa-storefront-www-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.rule" = "Host(`STOREFRONT_REDIRECT_HOST_PLACEHOLDER`)"
          "traefik.http.routers.tcg-medusa-storefront-www-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.entrypoints" = "websecure"
          "traefik.http.routers.tcg-medusa-storefront-www-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.tls" = "true"
          "traefik.http.routers.tcg-medusa-storefront-www-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.tls.certresolver" = "letsencrypt"
          "traefik.http.routers.tcg-medusa-storefront-www-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.middlewares" = "tcg-medusa-storefront-www-redirect-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER"

          "traefik.http.middlewares.tcg-medusa-storefront-www-redirect-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.redirectregex.regex" = "^https?://STOREFRONT_REDIRECT_HOST_PLACEHOLDER/(.*)"
          "traefik.http.middlewares.tcg-medusa-storefront-www-redirect-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.redirectregex.replacement" = "https://STOREFRONT_HOST_PLACEHOLDER/$1"
          "traefik.http.middlewares.tcg-medusa-storefront-www-redirect-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.redirectregex.permanent" = "true"
          # PRODUCTION_REDIRECT_END

          "traefik.http.services.tcg-medusa-storefront-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.loadbalancer.server.port" = "8000"
        }

        auth {
          username = "${DOCKER_USERNAME}"
          password = "${DOCKER_PASSWORD}"
        }
      }

      env {
        NODE_ENV = "production"
        PORT     = "8000"
        DEPLOY_VERSION = "DEPLOY_VERSION_PLACEHOLDER"

        DEPLOYMENT_ENV                 = "DEPLOYMENT_ENVIRONMENT_PLACEHOLDER"
        MEDUSA_BACKEND_URL             = "https://API_HOST_PLACEHOLDER"
        NEXT_PUBLIC_MEDUSA_BACKEND_URL = "https://API_HOST_PLACEHOLDER"
        NEXT_PUBLIC_DEFAULT_REGION     = "gb"
        NEXT_PUBLIC_BASE_URL           = "https://STOREFRONT_HOST_PLACEHOLDER"
      }

      resources {
        cpu    = 500
        memory = 384
      }
    }
  }
}
