job "tcg-medusa-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER" {
  datacenters = ["dc1"]
  type        = "service"

  group "tcg-medusa" {
    network {
      port "backend" {
        to = 9000
      }
      port "storefront" {
        to = 8000
      }
    }

    task "backend" {
      driver = "docker"

      template {
        data = <<EOF
DATABASE_URL="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/database" }}{{ .database_url }}{{ end }}"
REDIS_URL="redis://172.17.0.1:6379"
JWT_SECRET="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ .jwt_secret }}{{ end }}"
COOKIE_SECRET="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ .cookie_secret }}{{ end }}"
STRIPE_API_KEY="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if .stripe_api_key }}{{ .stripe_api_key }}{{ end }}{{ end }}"
STRIPE_WEBHOOK_SECRET="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if .stripe_webhook_secret }}{{ .stripe_webhook_secret }}{{ end }}{{ end }}"
NEXT_PUBLIC_STRIPE_KEY="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if .stripe_publishable_key }}{{ .stripe_publishable_key }}{{ end }}{{ end }}"
TRANSACTIONAL_SMTP_HOST="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "transactional_smtp_host" }}{{ index . "transactional_smtp_host" }}{{ end }}{{ end }}"
TRANSACTIONAL_SMTP_PORT="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "transactional_smtp_port" }}{{ index . "transactional_smtp_port" }}{{ end }}{{ end }}"
TRANSACTIONAL_SMTP_SECURE="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "transactional_smtp_secure" }}{{ index . "transactional_smtp_secure" }}{{ end }}{{ end }}"
TRANSACTIONAL_SMTP_USER="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "transactional_smtp_user" }}{{ index . "transactional_smtp_user" }}{{ end }}{{ end }}"
TRANSACTIONAL_SMTP_PASSWORD="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "transactional_smtp_password" }}{{ index . "transactional_smtp_password" }}{{ end }}{{ end }}"
TRANSACTIONAL_FROM_EMAIL="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "transactional_from_email" }}{{ index . "transactional_from_email" }}{{ end }}{{ end }}"
TRANSACTIONAL_REPLY_TO_EMAIL="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "transactional_reply_to_email" }}{{ index . "transactional_reply_to_email" }}{{ end }}{{ end }}"
EBAY_API_BASE="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_api_base" }}{{ index . "ebay_api_base" }}{{ end }}{{ end }}"
EBAY_MARKETPLACE_ID="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_marketplace_id" }}{{ index . "ebay_marketplace_id" }}{{ end }}{{ end }}"
EBAY_LOCALE="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_locale" }}{{ index . "ebay_locale" }}{{ end }}{{ end }}"
EBAY_CURRENCY="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_currency" }}{{ index . "ebay_currency" }}{{ end }}{{ end }}"
EBAY_LISTING_DURATION="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_listing_duration" }}{{ index . "ebay_listing_duration" }}{{ end }}{{ end }}"
EBAY_PRICE_MODE="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_price_mode" }}{{ index . "ebay_price_mode" }}{{ end }}{{ end }}"
EBAY_BUYER_PROTECTION_FIXED="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_buyer_protection_fixed" }}{{ index . "ebay_buyer_protection_fixed" }}{{ end }}{{ end }}"
EBAY_CLIENT_ID="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_client_id" }}{{ index . "ebay_client_id" }}{{ end }}{{ end }}"
EBAY_CLIENT_SECRET="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_client_secret" }}{{ index . "ebay_client_secret" }}{{ end }}{{ end }}"
EBAY_REDIRECT_URI="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_redirect_uri" }}{{ index . "ebay_redirect_uri" }}{{ end }}{{ end }}"
EBAY_TOKEN_ENCRYPTION_KEY="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_token_encryption_key" }}{{ index . "ebay_token_encryption_key" }}{{ end }}{{ end }}"
EBAY_DEV_ID="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_dev_id" }}{{ index . "ebay_dev_id" }}{{ end }}{{ end }}"
EBAY_MERCHANT_LOCATION_KEY="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_merchant_location_key" }}{{ index . "ebay_merchant_location_key" }}{{ end }}{{ end }}"
EBAY_CATEGORY_ID="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_category_id" }}{{ index . "ebay_category_id" }}{{ end }}{{ end }}"
EBAY_FULFILLMENT_POLICY_ID="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_fulfillment_policy_id" }}{{ index . "ebay_fulfillment_policy_id" }}{{ end }}{{ end }}"
EBAY_PAYMENT_POLICY_ID="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_payment_policy_id" }}{{ index . "ebay_payment_policy_id" }}{{ end }}{{ end }}"
EBAY_RETURN_POLICY_ID="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_return_policy_id" }}{{ index . "ebay_return_policy_id" }}{{ end }}{{ end }}"
EBAY_WEBHOOK_ENDPOINT="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_webhook_endpoint" }}{{ index . "ebay_webhook_endpoint" }}{{ end }}{{ end }}"
EBAY_WEBHOOK_VERIFICATION_TOKEN="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_webhook_verification_token" }}{{ index . "ebay_webhook_verification_token" }}{{ end }}{{ end }}"
EBAY_OAUTH_SCOPES="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "ebay_oauth_scopes" }}{{ index . "ebay_oauth_scopes" }}{{ end }}{{ end }}"
CARDTRADER_API_TOKEN="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "cardtrader_api_token" }}{{ index . "cardtrader_api_token" }}{{ end }}{{ end }}"
CLICK_AND_DROP_ENABLED="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "click_and_drop_enabled" }}{{ index . "click_and_drop_enabled" }}{{ end }}{{ end }}"
CLICK_AND_DROP_API_KEY="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "click_and_drop_api_key" }}{{ index . "click_and_drop_api_key" }}{{ end }}{{ end }}"
CLICK_AND_DROP_PUSH_FROM="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "click_and_drop_push_from" }}{{ index . "click_and_drop_push_from" }}{{ end }}{{ end }}"
GOOGLE_ADS_CUSTOMER_ID="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "google_ads_customer_id" }}{{ index . "google_ads_customer_id" }}{{ end }}{{ end }}"
GOOGLE_ADS_LOGIN_CUSTOMER_ID="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "google_ads_login_customer_id" }}{{ index . "google_ads_login_customer_id" }}{{ end }}{{ end }}"
GOOGLE_ADS_CONVERSION_ACTION_ID="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "google_ads_conversion_action_id" }}{{ index . "google_ads_conversion_action_id" }}{{ end }}{{ end }}"
GOOGLE_DATA_MANAGER_CLIENT_ID="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "google_data_manager_client_id" }}{{ index . "google_data_manager_client_id" }}{{ end }}{{ end }}"
GOOGLE_DATA_MANAGER_CLIENT_SECRET="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "google_data_manager_client_secret" }}{{ index . "google_data_manager_client_secret" }}{{ end }}{{ end }}"
GOOGLE_DATA_MANAGER_REFRESH_TOKEN="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "google_data_manager_refresh_token" }}{{ index . "google_data_manager_refresh_token" }}{{ end }}{{ end }}"
EOF
        destination = "local/backend-secrets.env"
        env         = true
      }

      # Preparing the native runtime must not transfer legacy writer ownership.
      # Missing optional keys retain disabled operation and an inert private file.
      template {
        data = <<EOF
CHANNEL_SYNC_MODE="{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if (index . "channel_sync_mode").Value }}{{ (index . "channel_sync_mode").Value }}{{ else }}disabled{{ end }}{{ else }}disabled{{ end }}{{ else }}disabled{{ end }}"
CHANNEL_SYNC_EBAY_RUNTIME_ENABLED="{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if (index . "channel_sync_ebay_runtime_enabled").Value }}{{ (index . "channel_sync_ebay_runtime_enabled").Value }}{{ else }}false{{ end }}{{ else }}false{{ end }}{{ else }}false{{ end }}"
CHANNEL_SYNC_EBAY_RUNTIME_FILE="/secrets/ebay-native-runtime.json"
CHANNEL_SYNC_EBAY_RUNTIME_SOURCE="{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if (index . "channel_sync_ebay_runtime_source").Value }}{{ (index . "channel_sync_ebay_runtime_source").Value }}{{ else }}file{{ end }}{{ else }}file{{ end }}{{ else }}file{{ end }}"
CHANNEL_SYNC_EBAY_RUNTIME_CONNECTION_ID="{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if (index . "channel_sync_ebay_runtime_connection_id").Value }}{{ (index . "channel_sync_ebay_runtime_connection_id").Value }}{{ end }}{{ end }}{{ end }}"
CHANNEL_SYNC_EBAY_LISTINGS_ENABLED="{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if (index . "channel_sync_ebay_listings_enabled").Value }}{{ (index . "channel_sync_ebay_listings_enabled").Value }}{{ else }}false{{ end }}{{ else }}false{{ end }}{{ else }}false{{ end }}"
CHANNEL_SYNC_EBAY_LISTINGS_SOURCE="postgres"
CHANNEL_SYNC_EBAY_LISTINGS_CONNECTION_ID="{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if (index . "channel_sync_ebay_listings_connection_id").Value }}{{ (index . "channel_sync_ebay_listings_connection_id").Value }}{{ end }}{{ end }}{{ end }}"
CHANNEL_SYNC_CARDTRADER_OBSERVATION_ENABLED="{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if (index . "channel_sync_cardtrader_observation_enabled").Value }}{{ (index . "channel_sync_cardtrader_observation_enabled").Value }}{{ else }}false{{ end }}{{ else }}false{{ end }}{{ else }}false{{ end }}"
CHANNEL_SYNC_CARDTRADER_LISTINGS_ENABLED="{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if (index . "channel_sync_cardtrader_listings_enabled").Value }}{{ (index . "channel_sync_cardtrader_listings_enabled").Value }}{{ else }}false{{ end }}{{ else }}false{{ end }}{{ else }}false{{ end }}"
CHANNEL_SYNC_CARDTRADER_ORDERS_ENABLED="{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if (index . "channel_sync_cardtrader_orders_enabled").Value }}{{ (index . "channel_sync_cardtrader_orders_enabled").Value }}{{ else }}false{{ end }}{{ else }}false{{ end }}{{ else }}false{{ end }}"
CHANNEL_SYNC_CARDTRADER_NATIVE_ORDERS_ENABLED="{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if (index . "channel_sync_cardtrader_native_orders_enabled").Value }}{{ (index . "channel_sync_cardtrader_native_orders_enabled").Value }}{{ else }}false{{ end }}{{ else }}false{{ end }}{{ else }}false{{ end }}"
CHANNEL_SYNC_CARDTRADER_INTAKE_ENABLED="{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if (index . "channel_sync_cardtrader_intake_enabled").Value }}{{ (index . "channel_sync_cardtrader_intake_enabled").Value }}{{ else }}false{{ end }}{{ else }}false{{ end }}{{ else }}false{{ end }}"
CHANNEL_SYNC_CARDTRADER_SHIPMENTS_ENABLED="{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if (index . "channel_sync_cardtrader_shipments_enabled").Value }}{{ (index . "channel_sync_cardtrader_shipments_enabled").Value }}{{ else }}false{{ end }}{{ else }}false{{ end }}{{ else }}false{{ end }}"
CHANNEL_SYNC_ATTACHMENT_BINDINGS_ENABLED="{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if (index . "channel_sync_attachment_bindings_enabled").Value }}{{ (index . "channel_sync_attachment_bindings_enabled").Value }}{{ else }}false{{ end }}{{ else }}false{{ end }}{{ else }}false{{ end }}"
CHANNEL_SYNC_ATTACHMENT_NATIVE_FENCE_ENABLED="{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if (index . "channel_sync_attachment_native_fence_enabled").Value }}{{ (index . "channel_sync_attachment_native_fence_enabled").Value }}{{ else }}false{{ end }}{{ else }}false{{ end }}{{ else }}false{{ end }}"
CHANNEL_SYNC_ATTACHMENT_FINANCIAL_CREATION_ENABLED="{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if (index . "channel_sync_attachment_financial_creation_enabled").Value }}{{ (index . "channel_sync_attachment_financial_creation_enabled").Value }}{{ else }}false{{ end }}{{ else }}false{{ end }}{{ else }}false{{ end }}"
CHANNEL_SYNC_ATTACHMENT_PLUGIN_PICKS_ENABLED="{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if (index . "channel_sync_attachment_plugin_picks_enabled").Value }}{{ (index . "channel_sync_attachment_plugin_picks_enabled").Value }}{{ else }}false{{ end }}{{ else }}false{{ end }}{{ else }}false{{ end }}"
CHANNEL_SYNC_ATTACHMENT_SETTLEMENTS_ENABLED="{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if (index . "channel_sync_attachment_settlements_enabled").Value }}{{ (index . "channel_sync_attachment_settlements_enabled").Value }}{{ else }}false{{ end }}{{ else }}false{{ end }}{{ else }}false{{ end }}"
CHANNEL_SYNC_ATTACHMENT_SHIPPING_OPTION_ID="{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if (index . "channel_sync_attachment_shipping_option_id").Value }}{{ (index . "channel_sync_attachment_shipping_option_id").Value }}{{ end }}{{ end }}{{ end }}"
CHANNEL_SYNC_ATTACHMENT_LOCATION_ID="{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if (index . "channel_sync_attachment_location_id").Value }}{{ (index . "channel_sync_attachment_location_id").Value }}{{ end }}{{ end }}{{ end }}"
EOF
        destination = "secrets/channel-sync.env"
        env         = true
        perms       = "0600"
        change_mode = "restart"
      }

      template {
        data = <<EOF
{{ if nomadVarExists "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/channel-sync" }}{{ if eq (index . "channel_sync_ebay_runtime_source").Value "postgres" }}{}{{ else if (index . "channel_sync_ebay_runtime_parts").Value }}{{ range $path := split "," (index . "channel_sync_ebay_runtime_parts").Value }}{{ with nomadVar $path }}{{ (index . "json_part").Value }}{{ end }}{{ end }}{{ else if (index . "channel_sync_ebay_runtime_json").Value }}{{ (index . "channel_sync_ebay_runtime_json").Value }}{{ else }}{}{{ end }}{{ else }}{}{{ end }}{{ else }}{}{{ end }}
EOF
        destination = "secrets/ebay-native-runtime.json"
        perms       = "0600"
        uid         = 1000
        gid         = 1000
        change_mode = "restart"
      }

      template {
        data = <<EOF
MERCHANT_SYNC_ENABLED="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/merchant" }}{{ if index . "merchant_sync_enabled" }}{{ index . "merchant_sync_enabled" }}{{ end }}{{ end }}"
MERCHANT_ACCOUNT_ID="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/merchant" }}{{ if index . "merchant_account_id" }}{{ index . "merchant_account_id" }}{{ end }}{{ end }}"
MERCHANT_DATA_SOURCE_ID="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/merchant" }}{{ if index . "merchant_data_source_id" }}{{ index . "merchant_data_source_id" }}{{ end }}{{ end }}"
MERCHANT_SITE_URL="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/merchant" }}{{ if index . "merchant_site_url" }}{{ index . "merchant_site_url" }}{{ end }}{{ end }}"
GOOGLE_APPLICATION_CREDENTIALS="/local/gcs-service-account.json"
EOF
        destination = "local/merchant-secrets.env"
        env         = true
      }

      template {
        data = <<EOF
{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/merchant" }}{{ if index . "google_service_account_json" }}{{ index . "google_service_account_json" }}{{ end }}{{ end }}
EOF
        destination = "local/gcs-service-account.json"
      }

      template {
        data = <<EOF
DOCKER_USERNAME="{{ with nomadVar "personifi/ghcr" }}{{ .username }}{{ end }}"
DOCKER_PASSWORD="{{ with nomadVar "personifi/ghcr" }}{{ .password }}{{ end }}"
EOF
        destination = "local/backend-docker-auth.env"
        env         = true
      }

      config {
        image = "BACKEND_IMAGE_PLACEHOLDER"
        ports = ["backend"]
        volumes = [
          "TCG_MEDUSA_STATE_PATH_PLACEHOLDER/static:/app/apps/backend/.medusa/server/static"
        ]

        labels = {
          "traefik.enable" = "true"

          "traefik.http.routers.tcg-medusa-api-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.rule" = "Host(`API_HOST_PLACEHOLDER`)"
          "traefik.http.routers.tcg-medusa-api-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.entrypoints" = "web"

          "traefik.http.routers.tcg-medusa-api-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.rule" = "Host(`API_HOST_PLACEHOLDER`)"
          "traefik.http.routers.tcg-medusa-api-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.entrypoints" = "websecure"
          "traefik.http.routers.tcg-medusa-api-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.tls" = "true"
          "traefik.http.routers.tcg-medusa-api-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.tls.certresolver" = "letsencrypt"

          "traefik.http.services.tcg-medusa-api-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.loadbalancer.server.port" = "9000"
        }

        auth {
          username = "${DOCKER_USERNAME}"
          password = "${DOCKER_PASSWORD}"
        }
      }

      env {
        NODE_ENV = "production"
        PORT     = "9000"
        DEPLOY_VERSION = "DEPLOY_VERSION_PLACEHOLDER"
        CI = "true"
        PNPM_CONFIG_CONFIRM_MODULES_PURGE = "false"

        DEPLOYMENT_ENV = "DEPLOYMENT_ENVIRONMENT_PLACEHOLDER"
        ALLOW_PRODUCTION_DATA_MUTATION = "PRODUCTION_DATA_MUTATION_PLACEHOLDER"
        STORE_CORS = "https://STOREFRONT_HOST_PLACEHOLDER"
        ADMIN_CORS = "https://API_HOST_PLACEHOLDER"
        AUTH_CORS  = "https://API_HOST_PLACEHOLDER,https://STOREFRONT_HOST_PLACEHOLDER"
        MEDUSA_BACKEND_URL = "https://API_HOST_PLACEHOLDER"
        # Public PostHog project token (already in the storefront bundle) for
        # server-side purchase and marketplace sale events.
        POSTHOG_PROJECT_TOKEN = "phc_pkyap9y4PpeKSrdUpgQ7XRu87eJGVyagZ7bEatCTkSZj"
        POSTHOG_HOST          = "https://eu.i.posthog.com"
      }

      resources {
        cpu    = 500
        memory = 1536
      }
    }

    task "redis" {
      driver = "docker"

      config {
        image        = "redis:7-alpine"
        network_mode = "host"
        args         = ["redis-server", "--appendonly", "yes", "--bind", "127.0.0.1", "172.17.0.1"]
        volumes = [
          "TCG_MEDUSA_STATE_PATH_PLACEHOLDER/redis:/data"
        ]
      }

      resources {
        cpu    = 100
        memory = 128
      }
    }

    task "storefront" {
      driver = "docker"

      template {
        data = <<EOF
DOCKER_USERNAME="{{ with nomadVar "personifi/ghcr" }}{{ .username }}{{ end }}"
DOCKER_PASSWORD="{{ with nomadVar "personifi/ghcr" }}{{ .password }}{{ end }}"
MEDUSA_PUBLISHABLE_KEY="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ .publishable_key }}{{ end }}"
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ .publishable_key }}{{ end }}"
NEXT_PUBLIC_STRIPE_KEY="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ .stripe_publishable_key }}{{ end }}"
SMTP_HOST="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "contact_smtp_host" }}{{ index . "contact_smtp_host" }}{{ end }}{{ end }}"
SMTP_PORT="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "contact_smtp_port" }}{{ index . "contact_smtp_port" }}{{ end }}{{ end }}"
SMTP_SECURE="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "contact_smtp_secure" }}{{ index . "contact_smtp_secure" }}{{ end }}{{ end }}"
SMTP_USER="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "contact_smtp_user" }}{{ index . "contact_smtp_user" }}{{ end }}{{ end }}"
SMTP_PASSWORD="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "contact_smtp_password" }}{{ index . "contact_smtp_password" }}{{ end }}{{ end }}"
CONTACT_FROM_EMAIL="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "contact_from_email" }}{{ index . "contact_from_email" }}{{ end }}{{ end }}"
CONTACT_TO_EMAIL="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "contact_to_email" }}{{ index . "contact_to_email" }}{{ end }}{{ end }}"
CONTACT_BCC_EMAIL="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if index . "contact_bcc_email" }}{{ index . "contact_bcc_email" }}{{ end }}{{ end }}"
EOF
        destination = "local/storefront-secrets.env"
        env         = true
      }

      config {
        image = "STOREFRONT_IMAGE_PLACEHOLDER"
        ports = ["storefront"]

        labels = {
          "traefik.enable" = "true"

          "traefik.http.routers.tcg-medusa-storefront-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.rule" = "Host(`STOREFRONT_HOST_PLACEHOLDER`)"
          "traefik.http.routers.tcg-medusa-storefront-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.entrypoints" = "web"

          "traefik.http.routers.tcg-medusa-storefront-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.rule" = "Host(`STOREFRONT_HOST_PLACEHOLDER`)"
          "traefik.http.routers.tcg-medusa-storefront-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.entrypoints" = "websecure"
          "traefik.http.routers.tcg-medusa-storefront-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.tls" = "true"
          "traefik.http.routers.tcg-medusa-storefront-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.tls.certresolver" = "letsencrypt"

          # PRODUCTION_REDIRECT_START
          "traefik.http.routers.tcg-medusa-storefront-www-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.rule" = "Host(`STOREFRONT_REDIRECT_HOST_PLACEHOLDER`)"
          "traefik.http.routers.tcg-medusa-storefront-www-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.entrypoints" = "web"
          "traefik.http.routers.tcg-medusa-storefront-www-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.middlewares" = "tcg-medusa-storefront-www-redirect-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER"

          "traefik.http.routers.tcg-medusa-storefront-www-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.rule" = "Host(`STOREFRONT_REDIRECT_HOST_PLACEHOLDER`)"
          "traefik.http.routers.tcg-medusa-storefront-www-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.entrypoints" = "websecure"
          "traefik.http.routers.tcg-medusa-storefront-www-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.tls" = "true"
          "traefik.http.routers.tcg-medusa-storefront-www-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.tls.certresolver" = "letsencrypt"
          "traefik.http.routers.tcg-medusa-storefront-www-secure-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.middlewares" = "tcg-medusa-storefront-www-redirect-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER"

          "traefik.http.middlewares.tcg-medusa-storefront-www-redirect-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.redirectregex.regex" = "^https?://STOREFRONT_REDIRECT_HOST_PLACEHOLDER/(.*)"
          "traefik.http.middlewares.tcg-medusa-storefront-www-redirect-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.redirectregex.replacement" = "https://STOREFRONT_HOST_PLACEHOLDER/$1"
          "traefik.http.middlewares.tcg-medusa-storefront-www-redirect-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.redirectregex.permanent" = "true"
          # PRODUCTION_REDIRECT_END

          "traefik.http.services.tcg-medusa-storefront-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER.loadbalancer.server.port" = "8000"
        }

        auth {
          username = "${DOCKER_USERNAME}"
          password = "${DOCKER_PASSWORD}"
        }
      }

      env {
        NODE_ENV = "production"
        PORT     = "8000"
        DEPLOY_VERSION = "DEPLOY_VERSION_PLACEHOLDER"

        DEPLOYMENT_ENV                 = "DEPLOYMENT_ENVIRONMENT_PLACEHOLDER"
        MEDUSA_BACKEND_URL             = "https://API_HOST_PLACEHOLDER"
        NEXT_PUBLIC_MEDUSA_BACKEND_URL = "https://API_HOST_PLACEHOLDER"
        NEXT_PUBLIC_DEFAULT_REGION     = "gb"
        NEXT_PUBLIC_BASE_URL           = "https://STOREFRONT_HOST_PLACEHOLDER"
      }

      resources {
        cpu    = 500
        memory = 384
      }
    }
  }
}
