job "tcg-medusa-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER-config" {
  datacenters = ["dc1"]
  type        = "batch"

  group "config" {
    restart {
      attempts = 0
      mode     = "fail"
    }

    task "apply-store-config" {
      driver = "docker"

      template {
        data = <<EOF
DATABASE_URL="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/database" }}{{ .database_url }}{{ end }}"
JWT_SECRET="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ .jwt_secret }}{{ end }}"
COOKIE_SECRET="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ .cookie_secret }}{{ end }}"
STRIPE_API_KEY="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if .stripe_api_key }}{{ .stripe_api_key }}{{ end }}{{ end }}"
STRIPE_WEBHOOK_SECRET="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if .stripe_webhook_secret }}{{ .stripe_webhook_secret }}{{ end }}{{ end }}"
NEXT_PUBLIC_STRIPE_KEY="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ if .stripe_publishable_key }}{{ .stripe_publishable_key }}{{ end }}{{ end }}"
EOF
        destination = "local/backend-secrets.env"
        env         = true
      }

      template {
        data = <<EOF
DOCKER_USERNAME="{{ with nomadVar "personifi/ghcr" }}{{ .username }}{{ end }}"
DOCKER_PASSWORD="{{ with nomadVar "personifi/ghcr" }}{{ .password }}{{ end }}"
EOF
        destination = "local/docker-auth.env"
        env         = true
      }

      config {
        image   = "BACKEND_IMAGE_PLACEHOLDER"
        command = "sh"
        args    = ["-c", "pnpm medusa exec ./src/scripts/apply-store-config.ts"]

        auth {
          username = "${DOCKER_USERNAME}"
          password = "${DOCKER_PASSWORD}"
        }
      }

      env {
        NODE_ENV = "production"
        DEPLOYMENT_ENV = "DEPLOYMENT_ENVIRONMENT_PLACEHOLDER"
        ALLOW_PRODUCTION_DATA_MUTATION = "true"
        CI       = "true"

        STORE_CORS = "https://STOREFRONT_HOST_PLACEHOLDER"
        ADMIN_CORS = "https://API_HOST_PLACEHOLDER"
        AUTH_CORS  = "https://API_HOST_PLACEHOLDER,https://STOREFRONT_HOST_PLACEHOLDER"
      }

      resources {
        cpu    = 500
        memory = 384
      }
    }
  }
}
