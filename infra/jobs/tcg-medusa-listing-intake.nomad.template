job "tcg-medusa-DEPLOYMENT_ENVIRONMENT_PLACEHOLDER-listing-intake" {
  datacenters = ["dc1"]
  type        = "batch"

  group "listing-intake" {
    restart {
      attempts = 0
      mode     = "fail"
    }

    task "sync-listing-intake" {
      driver = "docker"

      template {
        data = <<EOF
DATABASE_URL="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/database" }}{{ .database_url }}{{ end }}"
JWT_SECRET="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ .jwt_secret }}{{ end }}"
COOKIE_SECRET="{{ with nomadVar "TCG_MEDUSA_VAR_PATH_PLACEHOLDER/secrets" }}{{ .cookie_secret }}{{ end }}"
EOF
        destination = "local/backend-secrets.env"
        env         = true
      }

      template {
        data = <<EOF
DOCKER_USERNAME="{{ with nomadVar "personifi/ghcr" }}{{ .username }}{{ end }}"
DOCKER_PASSWORD="{{ with nomadVar "personifi/ghcr" }}{{ .password }}{{ end }}"
EOF
        destination = "local/docker-auth.env"
        env         = true
      }

      config {
        image   = "BACKEND_IMAGE_PLACEHOLDER"
        command = "sh"
        args    = ["-c", "pnpm medusa exec ./src/scripts/sync-listing-intake.ts"]
        volumes = [
          "TCG_MEDUSA_STATE_PATH_PLACEHOLDER/static:/app/apps/backend/.medusa/server/static",
          "TCG_MEDUSA_STATE_PATH_PLACEHOLDER/catalog-intake:/catalog-intake:ro"
        ]
        auth {
          username = "${DOCKER_USERNAME}"
          password = "${DOCKER_PASSWORD}"
        }
      }

      env {
        NODE_ENV = "production"
        DEPLOYMENT_ENV = "DEPLOYMENT_ENVIRONMENT_PLACEHOLDER"
        CI       = "true"

        STORE_CORS = "https://STOREFRONT_HOST_PLACEHOLDER"
        ADMIN_CORS = "https://API_HOST_PLACEHOLDER"
        AUTH_CORS  = "https://API_HOST_PLACEHOLDER,https://STOREFRONT_HOST_PLACEHOLDER"
        MEDUSA_BACKEND_URL = "https://API_HOST_PLACEHOLDER"
        CATALOG_INTAKE_MEDIA_DIR = "/app/apps/backend/.medusa/server/static/catalog"
        CATALOG_INTAKE_CSV_PATH  = "/catalog-intake/listing-intake.csv"
      }

      resources {
        cpu    = 500
        memory = 384
      }
    }
  }
}
